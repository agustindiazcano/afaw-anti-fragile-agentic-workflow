digraph state_and_context {
  graph [fontname="Helvetica", fontsize=13, bgcolor="white", pad=0.3, nodesep=0.5, ranksep=0.45, splines=true, rankdir=TB];
  node  [shape=box, style="rounded,filled", fontname="Helvetica", fontsize=13, color="#52606d", fillcolor="#f5f7fa", fontcolor="#1f2933", penwidth=1.2, margin="0.25,0.13"];
  edge  [fontname="Helvetica", fontsize=11, color="#52606d", fontcolor="#3e4c59", arrowsize=0.8, penwidth=1.1];

  node [fillcolor="#e1effe", color="#1c64f2"];
  agent [label="Agent (any number in parallel)"];

  node [fillcolor="#ede9fe", color="#6d28d9"];
  own   [label="The agent writes only its own files\ncontext/tasks/task_NNN_context.json (delta)\nstate/tasks/task_NNN.json (task file)"];

  node [fillcolor="#f5f7fa", color="#52606d"];
  pr    [label="Task PR\nthe delta and task file travel with the code"];

  node [fillcolor="#dcfce7", color="#15803d"];
  check [label="CI: check_task_files.py and check_task_delta.py\nlifecycle, no declared measurements, unique ids,\nfiles_touched equal to the changed code files"];

  node [fillcolor="#fef3c7", color="#b45309"];
  human [label="Human approves and merges the PR"];

  node [fillcolor="#ede9fe", color="#6d28d9"];
  src   [label="Sources on main (versioned)\nstate/tasks/*.json, context/tasks/*.json\ndocs/adr/*.md, docs/gotchas/*.md"];

  node [fillcolor="#dcfce7", color="#15803d"];
  build [label="scripts/build_state.py (on demand, deterministic)\n+ facts measured from git and the CI API"];

  node [fillcolor="#f5f7fa", color="#52606d", style="rounded,filled,dashed"];
  views [label="Derived views in build/, never committed\nLASTCONTEXT.md (global, per role), pending, history,\nmetrics, dashboard"];

  agent -> own -> pr -> check;
  check -> human [label=" checks pass"];
  human -> src [label=" merged"];
  src -> build -> views;
}
