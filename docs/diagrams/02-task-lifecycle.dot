digraph task_lifecycle {
  graph [fontname="Helvetica", fontsize=13, bgcolor="white", pad=0.3, nodesep=0.5, ranksep=0.42, splines=true, rankdir=TB];
  node  [shape=box, style="rounded,filled", fontname="Helvetica", fontsize=13, color="#1c64f2", fillcolor="#e1effe", fontcolor="#1f2933", penwidth=1.2, margin="0.25,0.12"];
  edge  [fontname="Helvetica", fontsize=11, color="#52606d", fontcolor="#3e4c59", arrowsize=0.8, penwidth=1.1];

  s1  [label="1. Ask the human for ROLE:"];
  s2  [label="2. Read PENDING.md and the generated LASTCONTEXT.md\n(global and role), built from origin/main"];
  s3  [label="3. Step 0: git status and git branch\nOther agents are working in this repo"];
  s4  [label="4. Create a new isolated branch named after the task\nfeat/, fix/ or chore/ + clear description"];
  s5  [label="5. Strict TDD, local tier only\nrun the one test being written: red, green, refactor"];
  s6  [label="6. One feature = one atomic commit\nConventional Commits: type(scope): description"];

  node [fillcolor="#dcfce7", color="#15803d"];
  s7  [label="7. Push. CI runs the full suite, lint, types,\nthe red-first check and mutation testing"];
  d1  [shape=diamond, style="filled", margin="0.05,0.05", label="CI green?"];

  node [fillcolor="#e1effe", color="#1c64f2"];
  s8  [label="8. Delta (summary, next; files_touched from the diff),\ntask file, ADR for any decision\nSeparate docs(scope) commit, documents only"];
  s9  [label="9. Ask whether to create the PR\nunless the human already asked for it"];
  s10 [label="10. PR with title, description\nand the CI run link"];

  node [fillcolor="#fef3c7", color="#b45309"];
  s11 [label="11. Human approves the PR manually\nMerge only with an explicit human directive"];

  node [fillcolor="#e1effe", color="#1c64f2"];
  s12 [label="12. Delete the branch after the merge"];

  s1 -> s2 -> s3 -> s4 -> s5 -> s6 -> s7 -> d1;
  d1 -> s5 [label=" no: fix, then push again", constraint=false, color="#b91c1c", fontcolor="#b91c1c"];
  d1 -> s8 [label=" yes"];
  s8 -> s9 -> s10 -> s11 -> s12;
}
